# Public site origin used for canonical / sitemap / Open Graph URLs.
# Account/org Pages root for this site:
NEXT_PUBLIC_SITE_URL=https://wardogs-wiki.github.io

# GitHub project Pages usually needs a repo path, e.g. /wardogs
# User/org Pages root or custom domain should leave this empty.
NEXT_PUBLIC_BASE_PATH=

# Hostname only when using a custom domain (no https:// and no path).
# Leave empty for github.io project/user Pages.
NEXT_PUBLIC_CUSTOM_DOMAIN=

# Launch indexing switch. Keep false until the final domain is live.
# Set exactly to "true" to enable robots allow + index/follow on content pages.
NEXT_PUBLIC_READY_FOR_LAUNCH=true

# Public contact — provide at least one before readyForLaunch=true.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_URL=https://github.com/wardogs-wiki/wardogs-wiki.github.io/issues

# Optional theme / integrations
NEXT_PUBLIC_THEME_PRESET=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-FYM0EFQ8W2
NEXT_PUBLIC_PIRSCH_CODE=
# Adsterra ad codes (banner, native, social bar) live in config/ads.ts — no env vars needed.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
